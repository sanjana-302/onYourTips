# Copy to .env and adjust. All settings are optional.
# OYT_DB_PATH=data/onyourtips.db
# OYT_SOURCES_FILE=config/sources.yaml
# OYT_TAXONOMY_FILE=config/taxonomy.yaml
# OYT_MAX_AGE_DAYS=7
# OYT_CONCURRENCY=6

# Optional: raises GitHub search rate limit from 10 to 30 req/min.
# GITHUB_TOKEN=ghp_xxx

# --- AI (local models via Ollama; see docs/adr/0004)
# OYT_LLM_MODEL=llama3.2:3b
# OYT_OLLAMA_URL=http://localhost:11434
# OYT_LLM_NUM_CTX=8192
# OYT_LLM_TIMEOUT=180
# OYT_LLM_THINK=false          # for thinking models (e.g. qwen3.5): answer directly
# OYT_LLM_DAILY_CALL_LIMIT=2000
